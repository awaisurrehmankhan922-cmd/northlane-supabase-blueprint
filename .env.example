# Copy to .env on the host. Never commit .env. Never put any of these in Settings.

# Database (the Node API connects as the postgres role; per-request it SET ROLEs to authenticated or service_role)
DATABASE_URL=postgresql://postgres:...@db.<project>.supabase.co:5432/postgres?sslmode=require
PG_POOL_MAX=10

# Supabase Auth (the API verifies user JWTs with this; London region project)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_JWT_SECRET=...
SUPABASE_SERVICE_ROLE_KEY=...        # server only, for Admin API (set app_metadata when a Founder changes roles)

# Email: test | off | graph | postmark
EMAIL_PROVIDER=test
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=office@northlane.example
POSTMARK_TOKEN=
POSTMARK_FROM=
WEBHOOK_KEY=                          # shared secret for bounce webhooks (x-nl-webhook-key)

# Texts: test | off | twilio
SMS_PROVIDER=test
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Phone events from the bridge (the bridge sends it as X-Phone-Key)
PHONE_EVENT_KEY=

# Hosting (from docs/DEPLOYING.md in the CRM)
NODE_ENV=production
PUBLIC_HOST=crm.northlane.example
TRUST_PROXY=1
SETUP_CODE=
SIGNIN_KEY=
